{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slushd:contracts:1.0.0",
  "$ref": "#/$defs/Response",
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "idea": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000
        },
        "language": {
          "type": "string",
          "enum": [
            "tr",
            "en"
          ]
        },
        "targetMarket": {
          "type": "string",
          "minLength": 1
        },
        "targetAudience": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "demo",
            "live"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "idea",
        "language",
        "targetMarket",
        "targetAudience",
        "mode"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "BUSY",
            "TIMEOUT",
            "TOOL_UNAVAILABLE",
            "INVALID_OUTPUT",
            "ANALYSIS_FAILED",
            "STORAGE_FAILED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "accessedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "accessedAt"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "sourced",
            "hypothesis",
            "mock"
          ]
        }
      },
      "required": [
        "id",
        "description",
        "sourceIds",
        "evidenceType"
      ],
      "additionalProperties": false
    },
    "Research": {
      "type": "object",
      "properties": {
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "website": {
                "type": "string",
                "pattern": "^https?://"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "differentiation": {
                "type": "string",
                "minLength": 1
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidenceType": {
                "type": "string",
                "enum": [
                  "sourced",
                  "mock"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "website",
              "description",
              "differentiation",
              "sourceIds",
              "evidenceType"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        },
        "trends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 3
        },
        "riskSignals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 3
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      },
      "required": [
        "competitors",
        "trends",
        "riskSignals",
        "sources"
      ],
      "additionalProperties": false
    },
    "Strategy": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidenceType": {
                "type": "string",
                "enum": [
                  "sourced",
                  "hypothesis",
                  "mock"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "severity",
              "mitigation",
              "sourceIds",
              "evidenceType"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "relatedRiskIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "title",
              "action",
              "priority",
              "relatedRiskIds"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        }
      },
      "required": [
        "summary",
        "risks",
        "recommendations"
      ],
      "additionalProperties": false
    },
    "Memory": {
      "type": "object",
      "properties": {
        "similarIdeas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "analysisId": {
                "type": "string",
                "minLength": 1
              },
              "idea": {
                "type": "string",
                "minLength": 1
              },
              "similarity": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "analysisId",
              "idea",
              "similarity"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        },
        "matchMethod": {
          "type": "string",
          "enum": [
            "keyword",
            "embedding",
            "none"
          ]
        }
      },
      "required": [
        "similarIdeas",
        "matchMethod"
      ],
      "additionalProperties": false
    },
    "ScenarioAssumptions": {
      "type": "object",
      "properties": {
        "monthlyVisitors": {
          "type": "integer",
          "minimum": 0
        },
        "conversionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "monthlyPrice": {
          "type": "number",
          "minimum": 0
        },
        "monthlyCosts": {
          "type": "number",
          "minimum": 0
        },
        "initialCash": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "monthlyVisitors",
        "conversionRate",
        "monthlyPrice",
        "monthlyCosts",
        "initialCash"
      ],
      "additionalProperties": false
    },
    "Simulation": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "optimistic",
                  "pessimistic"
                ]
              },
              "assumptions": {
                "$ref": "#/$defs/ScenarioAssumptions"
              },
              "payingCustomers": {
                "type": "integer",
                "minimum": 0
              },
              "monthlyRevenue": {
                "type": "number",
                "minimum": 0
              },
              "monthlyProfit": {
                "type": "number"
              },
              "runwayMonths": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "assumptions",
              "payingCustomers",
              "monthlyRevenue",
              "monthlyProfit",
              "runwayMonths"
            ],
            "additionalProperties": false
          },
          "maxItems": 2
        }
      },
      "required": [
        "currency",
        "disclaimer",
        "scenarios"
      ],
      "additionalProperties": false
    },
    "ResearchResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "failed",
            "skipped"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "live",
            "mock",
            "derived",
            "none"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/Research"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "origin",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    "StrategyResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "failed",
            "skipped"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "live",
            "mock",
            "derived",
            "none"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strategy"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "origin",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    "MemoryResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "failed",
            "skipped"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "live",
            "mock",
            "derived",
            "none"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/Memory"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "origin",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    "SimulationResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "failed",
            "skipped"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "live",
            "mock",
            "derived",
            "none"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/Simulation"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "origin",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    "Persistence": {
      "type": "object",
      "properties": {
        "saved": {
          "type": "boolean"
        },
        "recordId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "saved",
        "recordId",
        "error"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "demo",
            "live"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "$ref": "#/$defs/Request"
        },
        "research": {
          "$ref": "#/$defs/ResearchResult"
        },
        "strategy": {
          "$ref": "#/$defs/StrategyResult"
        },
        "memory": {
          "$ref": "#/$defs/MemoryResult"
        },
        "simulation": {
          "$ref": "#/$defs/SimulationResult"
        },
        "persistence": {
          "$ref": "#/$defs/Persistence"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "status",
        "mode",
        "createdAt",
        "durationMs",
        "input",
        "research",
        "strategy",
        "memory",
        "simulation",
        "persistence",
        "warnings"
      ],
      "additionalProperties": false
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "failed"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "status",
        "error"
      ],
      "additionalProperties": false
    },
    "ResearchInput": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/Request"
        }
      },
      "required": [
        "requestId",
        "input"
      ],
      "additionalProperties": false
    },
    "StrategyInput": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/Request"
        },
        "research": {
          "$ref": "#/$defs/ResearchResult"
        },
        "memory": {
          "$ref": "#/$defs/MemoryResult"
        }
      },
      "required": [
        "requestId",
        "input",
        "research",
        "memory"
      ],
      "additionalProperties": false
    },
    "MemoryInput": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "idea": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "requestId",
        "idea",
        "limit"
      ],
      "additionalProperties": false
    },
    "SimulationInput": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "optimistic": {
          "$ref": "#/$defs/ScenarioAssumptions"
        },
        "pessimistic": {
          "$ref": "#/$defs/ScenarioAssumptions"
        }
      },
      "required": [
        "requestId",
        "currency",
        "optimistic",
        "pessimistic"
      ],
      "additionalProperties": false
    },
    "SaveInput": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "analysis": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "requestId",
        "analysis"
      ],
      "additionalProperties": false
    }
  }
}
