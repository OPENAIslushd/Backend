{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simulation-agents.local/contracts/ui-response-1.0.json",
  "title": "UI recommendation data v1.0 (HTTP response data field)",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "run_id", "business_id", "product_id", "evaluation_id", "model_version", "currency", "data_provenance", "status", "recommendations", "warnings", "definitions", "assumptions"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "run_id": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/id" },
    "business_id": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/id" },
    "product_id": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/id" },
    "evaluation_id": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/id" },
    "model_version": { "const": "numerical-mvp-1.0.0" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "data_provenance": { "enum": ["synthetic", "user_supplied", "measured"] },
    "status": { "enum": ["complete", "insufficient_distinct_candidates"] },
    "recommendations": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile", "strategy", "metrics", "fixed_metrics", "paired_profit_delta", "reasons", "tradeoffs"],
        "properties": {
          "profile": { "enum": ["conservative", "balanced", "high_risk_high_reward"] },
          "strategy": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/strategy" },
          "metrics": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/metrics" },
          "fixed_metrics": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/metrics" },
          "paired_profit_delta": { "$ref": "https://simulation-agents.local/contracts/orchestrator-request-1.0.json#/definitions/result/properties/paired_profit_delta" },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "definitions": {
      "type": "object", "additionalProperties": false,
      "required": ["contribution_profit", "roi", "acquisition_cost", "range", "probability_of_loss"],
      "properties": { "contribution_profit": { "type": "string" }, "roi": { "type": "string" }, "acquisition_cost": { "type": "string" }, "range": { "type": "string" }, "probability_of_loss": { "type": "string" } }
    }
  }
}
