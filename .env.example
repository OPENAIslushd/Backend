HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
INTAKE_EXTRACTOR=demo
# CODEX_BIN=/absolute/path/to/current/codex
# Otherwise CODEX_CLI_PATH (desktop), then codex on PATH is used.
# AGENT_ADAPTER_MODULE=/absolute/path/to/team-adapters.cjs
# Set a model supported by the logged-in CLI account when enabling CLI extraction.
# CODEX_MODEL=gpt-6-astra
INTAKE_TIMEOUT_MS=30000
AGENT_TIMEOUT_MS=30000
PHASE_TIMEOUT_MS=120000
# Campaign simulation services: npm start launches them with a random token automatically.
# Set these only when the services run elsewhere (e.g. docker compose).
# SIM_SERVICES=external
# SIM_SERVICE_TOKEN=at-least-16-characters
# SIM_MEMORY_URL=http://127.0.0.1:8081
# SIM_STRATEGY_URL=http://127.0.0.1:8082
# SIM_SIMULATION_URL=http://127.0.0.1:8083
# SIM_OUTCOME_URL=http://127.0.0.1:8084
# PYTHON_BIN=python3
