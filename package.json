{
  "name": "slushd-orchestrator",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.cjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.cjs",
    "test": "npm test --prefix contracts && node --test test/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "smoke:cli": "node --env-file-if-exists=.env scripts/cli-smoke.cjs",
    "format": "prettier --write \"src/**/*.cjs\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" contracts/validate.cjs",
    "format:check": "prettier --check \"src/**/*.cjs\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" contracts/validate.cjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
